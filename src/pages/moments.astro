---
import Layout from "astro-sage/layouts/Layout.astro";
import katexCss from "katex/dist/katex.min.css?url";
import Header from "astro-sage/components/Header.astro";
import Footer from "astro-sage/components/Footer.astro";
import Main from "astro-sage/components/Main.astro";
import MomentFeed from "../components/MomentFeed.astro";
import { getMoments } from "../lib/content";
import config from "@sage/config";
const moments = await getMoments();
---
<Layout title={`Moments | ${config.site.title}`} description="Notes along the way.">
  <Fragment slot="head">{moments.some(moment => (moment.body ?? "").includes("$")) && <link rel="stylesheet" href={katexCss} />}</Fragment>
  <Header />
  <Main pageTitle="Moments" pageDesc="Notes along the way.">
    <div data-pagefind-body><MomentFeed {moments} /></div>
    {moments.length === 0 && <p class="text-muted-foreground">No moments yet.</p>}
  </Main>
  <Footer />
</Layout>
